{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "goal":{
            "display_name": "End Goal Emerald Cost",
            "description": "How many Emeralds are required for your goal?",
            "aliases": {"easiest": 0},
            "hidden": false
        },
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "values": {
                "recommended": 5,
                "max": 100,
                "default": 20
            }
        }
    },
    "user": {
        "section_1_cups":{
            "display_name": "Section 1 Cups",
            "description":[
                "Enable the section 1 cups? Ring Cup-Extra Cup"
            ],
            "type": "Toggle",
            "default": true
        },
        "section_2_cups":{
            "display_name": "Section 2 Cups",
            "description":[
                "Enable the section 2 cups? S.P.B. Cup-Egg Cup"
            ],
            "type": "Toggle",
            "default": true
        },
        "section_3_cups":{
            "display_name": "Section 3 Cups",
            "description":[
                "Enable the section 3 cups? Goggles Cup-Phantom Cup"
            ],
            "type": "Toggle",
            "default": false
        },
        "section_4_cups":{
            "display_name": "Section 4 Cups",
            "description":[
                "Enable the section 4 cups? Flash Cup-Skate Cup"
            ],
            "type": "Toggle",
            "default": false
        },
        "extra_cups":{
            "display_name": "Section 5 Cups",
            "description":[
                "Enable the section 5 cups? Recycle Cups, Lost & Found"
            ],
            "type": "Toggle",
            "default": false
        },
        "prisons":{
            "display_name": "Prisons",
            "description":[
                "Enable the prisons based battle modes?"
            ],
            "type": "Toggle",
            "default": true
        },
        "boss_races":{
            "display_name": "Boss Races",
            "description":[
                "Enable boss races? (Duel Races)"
            ],
            "type": "Toggle",
            "default": false
        },
        "special_stages":{
            "display_name": "Special Stages",
            "description":[
                "Enable the special stages and its keys?"
            ],
            "type": "Toggle",
            "default": true
        },
        "blend_eye_difficulty":{
            "display_name": "Blend Eye Difficulty",
            "description": [
                "Which varient of the Blend Eye boss would you like to fight?",
                "Note: This option doesn't affect anything in-game, it solely exists for host/manual client usage"
            ],
            "type": "Choice",
            "values": {
                "normal":0,
                "hard":1,
                "both":2,
                "modded":3
             },
            "default": 0,
            "allow_custom_value": false
        },
        "random_item_start":{
            "display_name": "Random Item",
            "description":[
                "Give yourself a random item?",
                "Useful if you downright don't like Ring Box only races"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "insta_whip":{
            "display_name": "Starting Insta-Whip",
            "description":[
                "Start with the Insta-Whip?"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "phantom_ruby":{
            "display_name": "Starting Phantom Ruby",
            "description":[
                "Start with the Phantom Ruby?",
                "Setting this to false effectively locks out boss races behind a key item."
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "super_emeralds":{
            "display_name": "Super Emeralds",
            "description":[
                "Add the Super Emeralds into the pool?",
                "Required to be enabled if you're doing the 14 Emerald Goal"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "nonprogressive_items":{
            "display_name": "Non-Progressive Items",
            "description":[
                "Use the non-progressive varient of items?",
                "Example: Banana and Triple Bananas separate items",
                " ",
                "### If this is toggled on, you MUST turn off 'Progressive Items' or things WILL break. ###"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Items"
        },
        "progressive_items":{
            "display_name": "Progressive Items",
            "description":[
                "Use the progressive varient of items?",
                "Example: 3 Progressive Bananas = Triple Bananas, 7 Progressive Ballhogs = Ballhog",
                " ",
                "### If this is toggled on, you MUST turn off 'Non-Progressive Items' or things WILL break. ###"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "useless_battlemode_items":{
            "display_name": "Useless Battlemode Items",
            "description":[
                "Add in the useless battlemode items into the pool? (Bonus Points, Bumper Restock)",
                "Note: When item received, this will intentionally freeze you in place since its a battlemode item, consider this as a 'trap' of sorts"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Items"
        },
        "vanilla_chars":{
            "display_name": "Vanilla Characters",
            "description":[
                "Add the base game characters into the pool? (RR v2.4)",
                " ",
                "Toggling multiple character options is not recommended as this will cause bloat and repeated items"
            ],
            "type": "Toggle",
            "default": true,
            "group": "Characters"
        },
        "modded_chars":{
            "display_name": "Class Types",
            "description":[
                "Add the different class types into the pool? Recommended for modded character usage",
                "Example: Class A (s1 - w1)",
                " ",
                "Toggling multiple character options is not recommended as this will cause bloat and repeated items"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Characters"
        },
        "class_bundles":{
            "display_name": "Bundle Classes",
            "description":[
                "Add the different class types bundled up into a single item?",
                "Example: Class A item = 9 characters",
                " ",
                "Toggling multiple character options is not recommended as this will cause bloat and repeated items"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Characters"
        },
        "lua_chars":{
            "display_name": ".lua Characters",
            "description":[
                "Add game defying characters as an optional item? You'll need to obtain the class item that lua character resides in however",
                "Example: Peppino, Feet Sonic, Super Sonic"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Characters"
        },
        "followers":{
            "display_name": "Followers",
            "description":[
                "Add followers as junk items?"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Junk"
        },
        "spray_cans":{
            "display_name": "Spray Cans",
            "description":[
                "Add spray cans as junk items?"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Junk"
        },
        "filler_jokes":{
            "display_name": "Jokes",
            "description":[
                "Add funny:tm: 'joke' items as junk items?"
            ],
            "type": "Toggle",
            "default": false,
            "group": "Junk"
        }
    }
}